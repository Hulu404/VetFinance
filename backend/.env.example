# Postgres connection of the Supabase project (Project Settings -> Database -> Connection string,
# "Session pooler" or "Transaction pooler"). The role must be allowed to `set role authenticated`
# (the default `postgres` user is).
DATABASE_URL=
# https://<project-ref>.supabase.co  (Project Settings -> API -> Project URL); used for JWKS
SUPABASE_URL=
# Fallback for HS256-signed tokens (Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=
# Expected `aud` claim, default "authenticated"
JWT_AUDIENCE=
# Comma-separated list of allowed frontend origins, e.g. https://app.vetfinance.online,http://localhost:5173
CORS_ORIGINS=
# Fernet key that encrypts Vetmanager API keys in the database. Generate once and keep it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Domains allowed for Vetmanager addresses (comma-separated); default is vetmanager.ru,vetmanager.cloud,vetmanager2.ru
VETMANAGER_HOST_SUFFIXES=
# true only for tests: enables POST /v1/connections/vetmanager/import (raw responses without a live account)
VETMANAGER_IMPORT_ENABLED=false
# Exports of reports per clinic per minute (default 10); raise only in test environments
# EXPORT_LIMIT_PER_MINUTE=10
